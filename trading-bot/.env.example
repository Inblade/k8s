# ── Скопируй этот файл в .env и заполни значения ──
# НИКОГДА не коммить .env с реальными ключами в git!

# API-ключи Binance.
# Для тестовой сети возьми ключи тут: https://testnet.binance.vision/
# Для реальной торговли — в личном кабинете Binance (API Management).
# Для ключей включай ТОЛЬКО права "Spot Trading". НЕ включай вывод средств (Withdrawals)!
# Боевые ключи (используются при TESTNET=false):
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Тестовые ключи (используются при TESTNET=true). Нужны для тумблера тест↔бой
# в окне. Если пусто — откат на BINANCE_API_KEY (совместимость).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Включение брокеров (можно оба сразу: крипта на Binance + акции на Alpaca).
BINANCE_ENABLED=true

# ── Alpaca (акции) ──
# Paper-ключи: app.alpaca.markets → Paper Trading → API Keys → Generate New Keys.
# ALPACA_PAPER=true -> песочница (как Binance testnet). Работает из Польши.
ALPACA_ENABLED=false
ALPACA_PAPER=true
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Тикеры акций. Широкие ETF (SPY, QQQ) для DCA БЕЗОПАСНЕЕ отдельных акций:
# одиночная бумага может необратимо упасть, а индекс склонен восстанавливаться.
ALPACA_SYMBOLS=SPY,QQQ
ALPACA_TRADE_QUOTE_AMOUNT=1000
# Отдельные DCA-параметры под акции. Если пусто — разумные дефолты под акции
# (спокойнее крипты): база/докупка $50, до 4 докупок, шаг 1.5%, TP 2%, стоп-лосс 12%.
ALPACA_DCA_BASE_ORDER=
ALPACA_DCA_SAFETY_ORDER=
ALPACA_DCA_MAX_SAFETY_ORDERS=
ALPACA_DCA_PRICE_DEVIATION_PCT=
ALPACA_DCA_TAKE_PROFIT_PCT=
ALPACA_DCA_STOP_LOSS_PCT=

# Режимы безопасности (Binance)
# DRY_RUN=true  -> бот считает сигналы, но НЕ отправляет реальные ордера (бумажная торговля).
# TESTNET=true  -> работа с тестовой сетью Binance (ненастоящие деньги).
DRY_RUN=true
TESTNET=true

# Выбор стратегии: dca (усреднение, рекомендуется для малого счёта) или swing (MA+RSI)
STRATEGY=dca

# Торговая пара(ы). Одна монета — SYMBOL. Несколько сразу — SYMBOLS через запятую
# (SYMBOLS имеет приоритет). Примеры пар к USDT: BTCUSDT, ETHUSDT, SOLUSDT, BNBUSDT,
# XRPUSDT, DOGEUSDT, ADAUSDT, AVAXUSDT, LINKUSDT, TONUSDT.
SYMBOL=BTCUSDT
# SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
# Таймфрейм свечей: 1m, 5m, 15m, 1h, 4h, 1d ... (для swing-стратегии)
INTERVAL=15m
# Бюджет КРИПТЫ (Binance), USDT. Подход «ядро-спутник»: крипта волатильна, держи
# её МАЛЫМ спутником (≤15% портфеля), а основной бюджет — на спокойные ETF
# (ALPACA_TRADE_QUOTE_AMOUNT). Окно подскажет рекомендуемое распределение по
# волатильности. Для dca — потолок ВСЕХ вложений за цикл по всем монетам.
TRADE_QUOTE_AMOUNT=150
# Потолок доли крипты в портфеле для рекомендации распределения (0.15 = 15%).
CRYPTO_MAX_WEIGHT=0.15

# ── Параметры DCA-стратегии (используются при STRATEGY=dca) ──
# Базовый (первый) ордер цикла, USDT
DCA_BASE_ORDER=30
# Размер каждого safety-ордера (докупки на просадке), USDT
DCA_SAFETY_ORDER=30
# Максимум safety-ордеров за цикл (база 30 + 5*30 = 180 USDT макс. при scale=1)
DCA_MAX_SAFETY_ORDERS=5
# На сколько % должна упасть цена от прошлой покупки, чтобы докупить
DCA_PRICE_DEVIATION_PCT=2.5
# Множитель шага просадки для каждой следующей докупки (1.0 = равные шаги)
DCA_SAFETY_STEP_SCALE=1.0
# Множитель объёма каждой следующей докупки (1.0 = одинаковые; >1 = докупать больше)
DCA_SAFETY_VOLUME_SCALE=1.0
# Тейк-профит: продать весь объём при росте на % выше средней цены входа
DCA_TAKE_PROFIT_PCT=3.0
# Стоп-лосс на цикл: продать всё при просадке на % НИЖЕ средней входа. 0 = выкл.
# Должен быть ШИРЕ суммарного покрытия докупок (иначе режет раньше усреднения).
DCA_STOP_LOSS_PCT=0
# Трендовый фильтр (Faber): новые циклы DCA открываются только когда цена ВЫШЕ
# длинной скользящей средней — не усредняемся в нисходящем тренде. По историческим
# данным примерно вдвое снижает максимальную просадку. Рекомендуется для акций.
DCA_TREND_FILTER_ENABLED=false
DCA_TREND_MA_PERIOD=200
DCA_TREND_INTERVAL=1d

# ATR-привязка: шаг и тейк-профит = недавняя волатильность × множитель (вместо
# фиксированных %). Работает только при ADAPTIVE_ENABLED=false.
DCA_ATR_ENABLED=false
DCA_ATR_PERIOD=14
DCA_ATR_STEP_MULT=1.0
DCA_ATR_TP_MULT=1.5
DCA_ATR_MIN_PCT=0.5
DCA_ATR_MAX_PCT=8.0

# Управление рисками (в процентах от цены входа)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# Параметры стратегии (скользящие средние и RSI)
FAST_MA=9
SLOW_MA=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Комиссия биржи за сделку, % (нужна для расчёта реализованной прибыли)
FEE_PCT=0.1

# ── Автовывод части прибыли на внешний кошелёк (например, TrustWallet) ──
# ⚠️ Требует у API-ключа права на ВЫВОД средств. По умолчанию ВЫКЛЮЧЕНО.
# Включай осознанно и обязательно настрой на Binance белый список адресов вывода!
WITHDRAW_ENABLED=false
# Какой процент прибыли откладывать к выводу
WITHDRAW_PROFIT_PCT=10
# Копить резерв, пока не наберётся столько (чтобы вывод не съелся комиссией сети)
WITHDRAW_MIN_AMOUNT=15
# Что и куда выводить. USDT по сети TRX (TRC20) — самые низкие комиссии.
# TrustWallet поддерживает USDT-TRC20. ВАЖНО: сеть на Binance и в кошельке должна совпадать!
WITHDRAW_ASSET=USDT
WITHDRAW_NETWORK=TRX
# Адрес твоего кошелька TrustWallet (для выбранной сети). Без него вывод не включится.
WITHDRAW_ADDRESS=

# Порт веб-дашборда (открывать http://localhost:8000)
DASHBOARD_PORT=8000

# ── Адаптивный режим: подстройка под рынок + оптимизация параметров ──
# Бот определяет тренд/боковик и: в тренде вниз ставит новые входы на паузу,
# в тренде вверх повышает тейк-профит, в боковике работает обычный DCA.
# Плюс периодически подбирает параметры на свежей истории (walk-forward).
# ⚠️ Подбор параметров — это подгонка под прошлое, не гарантия будущего.
ADAPTIVE_ENABLED=false
# Подбирать ли параметры (true) или только реагировать на режим рынка (false)
ADAPTIVE_OPTIMIZE=true
# На каком таймфрейме определять режим и оптимизировать
REGIME_INTERVAL=1h
# Сколько свечей анализировать
REGIME_LOOKBACK=500
# Переоптимизация каждые N шагов опроса
REOPTIMIZE_EVERY=50
# Во сколько раз поднять тейк-профит в восходящем тренде (дать прибыли «бежать»)
TREND_TP_MULTIPLIER=1.5
# Порог наклона EMA (%), выше которого рынок считается трендовым
REGIME_SLOPE_PCT=0.6
# Порог волатильности (%), выше которого новые входы ставятся на паузу
REGIME_HIGH_VOL_PCT=2.5

# Как часто опрашивать рынок (секунды)
POLL_INTERVAL_SECONDS=60
