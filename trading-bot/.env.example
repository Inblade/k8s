# ── Скопируй этот файл в .env и заполни значения ──
# НИКОГДА не коммить .env с реальными ключами в git!

# API-ключи Binance.
# Для тестовой сети возьми ключи тут: https://testnet.binance.vision/
# Для реальной торговли — в личном кабинете Binance (API Management).
# Для ключей включай ТОЛЬКО права "Spot Trading". НЕ включай вывод средств (Withdrawals)!
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Режимы безопасности
# DRY_RUN=true  -> бот считает сигналы, но НЕ отправляет реальные ордера (бумажная торговля).
# TESTNET=true  -> работа с тестовой сетью Binance (ненастоящие деньги).
DRY_RUN=true
TESTNET=true

# Торговая пара и параметры
SYMBOL=BTCUSDT
# Таймфрейм свечей: 1m, 5m, 15m, 1h, 4h, 1d ...
INTERVAL=15m
# Сколько USDT тратить на одну покупку (с учётом, что у тебя ~270$)
TRADE_QUOTE_AMOUNT=250

# Управление рисками (в процентах от цены входа)
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0

# Параметры стратегии (скользящие средние и RSI)
FAST_MA=9
SLOW_MA=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# Как часто опрашивать рынок (секунды)
POLL_INTERVAL_SECONDS=60
