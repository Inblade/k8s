[Unit]
Description=Trading-bot: проверка готовности к реалу (go-live gates)
After=trading-bot.service

[Service]
Type=oneshot
WorkingDirectory=/opt/trading-bot
# Отчёт в journald + уведомление в Telegram на переходах + JSON-история.
# Уведомление шлётся только если в .env есть TELEGRAM_BOT_TOKEN/CHAT_ID (как alert-check.sh).
ExecStart=/bin/sh -c '/usr/bin/python3 /opt/trading-bot/go_live_check.py --notify; /usr/bin/python3 /opt/trading-bot/go_live_check.py --json >> /opt/trading-bot/go-live-history.jsonl'
